{
  "version": "2",
  "supported_formats": [
    "linkedin_post",
    "linkedin_article",
    "blog_post"
  ],
  "disallowed_action_phrases": [
    "publish to linkedin",
    "post this to linkedin",
    "post it to linkedin",
    "schedule this post",
    "send this to",
    "publish the post",
    "publish this"
  ],
  "rules": {
    "use_only_user_provided_facts": true,
    "exploratory_products_may_use_labeled_assumptions": true,
    "never_claim_a_publish_or_send_happened": true,
    "ask_at_most_one_question_per_turn": true
  }
}
