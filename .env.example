# --- Required: OpenRouter is the only LLM gateway ---------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_MAX_TOKENS=2000
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=2

# Turn interpretation is extraction, not creativity — keep it near zero.
SIGNAL_INTERPRET_TEMPERATURE=0.0

# --- Conversation shaping ---------------------------------------------------
SIGNAL_HISTORY_WINDOW=12
SIGNAL_SUMMARIZE_AFTER=16

# --- Persistence ----------------------------------------------------------
# Thread state lives in a SQLite checkpointer; per-user memory is JSON.
SIGNAL_DATA_DIR=
# SIGNAL_DB_PATH defaults to <SIGNAL_DATA_DIR>/signal.db
SIGNAL_DB_PATH=

# --- Web adapter (backend/agent.py) -------------------------------------
SIGNAL_AGENT_PORT=8001
SIGNAL_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Optional: LangSmith tracing for LangChain/LangGraph runs -------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=signal-mvp
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_CALLBACKS_BACKGROUND=false

# --- Optional: Langfuse tracing (one trace per turn) ----------------------
# Session = thread_id, User = Google sub. Needs all three of enabled + keys.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Set false to mask prompt/completion text before it leaves the process.
LANGFUSE_TRACE_CONTENT=true

# --- Auth: Google login (handled by the Next.js BFF) ---------------------
# When true: the frontend requires a Google sign-in and the backend rejects
# any /agent or /api/* call that doesn't carry the shared SIGNAL_SESSION_SECRET
# as the `x-signal-proxy-secret` header. When false: a local dev user is used.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be an authorized redirect URI on the OAuth client. For local dev:
# http://localhost:5173/api/auth/callback
GOOGLE_REDIRECT_URI=https://your-domain.example/api/auth/callback
# Signs the session cookie AND is the frontend<->backend shared proxy secret.
SIGNAL_SESSION_SECRET=
# Set false only for plain-HTTP local dev.
SIGNAL_COOKIE_SECURE=true
# Where the Next.js BFF reaches the Python backend (compose sets this).
SIGNAL_BACKEND_URL=http://backend:8001
