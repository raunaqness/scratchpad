# --- Required: OpenRouter is the only LLM gateway ---------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_MAX_TOKENS=2000
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=2

# Turn interpretation is extraction, not creativity — keep it near zero.
SIGNAL_INTERPRET_TEMPERATURE=0.0

# --- Conversation shaping ---------------------------------------------------
SIGNAL_HISTORY_WINDOW=12
SIGNAL_SUMMARIZE_AFTER=16

# --- Persistence ----------------------------------------------------------
# Thread state lives in a SQLite checkpointer; per-user memory is JSON.
SIGNAL_DATA_DIR=
# SIGNAL_DB_PATH defaults to <SIGNAL_DATA_DIR>/signal.db
SIGNAL_DB_PATH=

# --- Web adapter (backend/agent.py) -------------------------------------
SIGNAL_AGENT_PORT=8001
SIGNAL_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Optional: LangSmith tracing for LangChain/LangGraph runs -------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=signal-mvp
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_CALLBACKS_BACKGROUND=false
