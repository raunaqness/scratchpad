# Required OpenRouter configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_MAX_TOKENS=2000
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=2

# Optional Langfuse Cloud tracing
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_TRACE_CONTENT=false

# Local server configuration
SIGNAL_HOST=127.0.0.1
SIGNAL_PORT=8008
SIGNAL_LOG_LEVEL=info

# Optional Google OpenID Connect login
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8008/api/auth/callback
SIGNAL_SESSION_SECRET=
SIGNAL_COOKIE_SECURE=false
# Set this to http://localhost:5173 for split frontend/backend development.
SIGNAL_FRONTEND_URL=
